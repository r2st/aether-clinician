# Backend environment template. Copy to apps/api/.env (gitignored).
APP_ENV=development
APP_SECRET_KEY=change-me-openssl-rand-hex-32
APP_DEBUG=true
DEMO_MODE=true

DATABASE_URL=postgresql+asyncpg://aether:aether@localhost:5432/aether_clinician
REDIS_URL=redis://localhost:6379/0

# Optional: enables Claude vision extraction. Without it, the deterministic
# text/OCR fallback is used (the system stays fully functional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
TESSERACT_CMD=/usr/bin/tesseract

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
